# Railway auto-injects DATABASE_URL when you attach a PostgreSQL plugin
DATABASE_URL=postgresql://user:password@localhost:5432/media_buying

JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your-script-id/exec

# Set to your Railway web service URL (e.g. https://your-web.up.railway.app)
# Supports comma-separated origins for multiple domains
FRONTEND_URL=http://localhost:5173

# Railway sets PORT automatically — do not set this on Railway
PORT=3001

# ─── Google Drive database backup (optional) ─────────────────────────────────
# Daily pg_dump of the whole database, gzipped and uploaded to a Drive folder.
# Backup stays DISABLED until both of the first two are set.
#
# Service-account key JSON (raw JSON or base64 of it). Create a service account
# in Google Cloud, enable the Drive API, and download its key.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The Drive folder ID to upload into. Share that folder with the service
# account's client_email as Editor.
GDRIVE_BACKUP_FOLDER_ID=
# Optional: impersonate a Workspace user (domain-wide delegation). Needed when
# the target folder is on a normal "My Drive" — service accounts have no
# storage quota, so otherwise use a Shared Drive folder.
GOOGLE_IMPERSONATE_SUBJECT=
# Optional: cron schedule (default "0 2 * * *" = 02:00 daily), retention count
# (default 30), pg_dump path, and cron timezone (default Asia/Colombo).
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION=30
PGDUMP_PATH=pg_dump
BACKUP_TZ=Asia/Colombo

# ─── Financial API (/api/financial, external payment tracker) ────────────────
# Isolated additive API for the Lovable financial frontend. See
# docs/FINANCIAL_API.md. Set FINANCIAL_API_ENABLED=false to unmount it entirely.
#
# Signs the financial bearer tokens. MUST differ from JWT_SECRET — sharing it
# would make a long-lived financial token valid against the whole Orbit API.
FINANCIAL_JWT_SECRET=
# Comma-separated CORS allow-list for /api/financial/* only (the app's own
# FRONTEND_URL is untouched). `*` wildcards are supported for preview URLs:
#   https://*.lovable.app,https://tracker.yourdomain.com
# Unset = no cross-origin browser access.
ALLOWED_FINANCIAL_ORIGIN=
# Optional
FINANCIAL_TOKEN_TTL=12h
FINANCIAL_API_ENABLED=true
# true = hub/boardroom see every record instead of only their own accounts
FINANCIAL_SCOPE_ALL_ROLES=false
# ILIKE patterns matched against ScheduleLog.importExtra keys, where the bulk
# importer keeps the invoice/payment date columns from the spreadsheet
FINANCIAL_INVOICE_SENT_KEYS=
FINANCIAL_PAYMENT_RECEIVED_KEYS=
# DMY or MDY, for ambiguous d/m/Y date strings in those columns
FINANCIAL_DATE_ORDER=DMY
# false = ignore importExtra, read dates only from financial_payment_records
FINANCIAL_IMPORT_EXTRA_DATES=true
