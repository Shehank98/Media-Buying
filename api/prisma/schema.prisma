generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  GROUP_HEAD
  PLANNER
}

enum ChannelType {
  TV
  RADIO
  PRINT
  DIGITAL
  CINEMA
  OOH
}

enum UploadStatus {
  PENDING
  PROCESSING
  REVIEW
  COMPLETE
  FAILED
}

enum RowStatus {
  OK
  NEEDS_REVIEW
  FAILED
}

enum PackageInterest {
  INTERESTED
  NOT_INTERESTED
  NEGOTIATE
}

enum ResponseFollowUp {
  PENDING
  FOLLOWED_UP
  BOOKED
  CLOSED
}

// A client's negotiated agency remuneration: either a commission percentage
// (COMMISSION, value = %) or a fixed Agency-of-Record fee (AOR, value = LKR).
enum CommissionType {
  COMMISSION
  AOR
}

enum RevenueVerifyStatus {
  PENDING
  VERIFIED
  DISPUTED
}

model User {
  id                        Int                      @id @default(autoincrement())
  email                     String                   @unique
  passwordHash              String                   @map("password_hash")
  name                      String
  role                      Role
  mustChangePassword        Boolean                  @default(true) @map("must_change_password")
  pageAccess                String[]                 @default([]) @map("page_access")
  canExport                 Boolean                  @default(true) @map("can_export")
  readOnly                  Boolean                  @default(false) @map("read_only")
  failedLogins              Int                      @default(0) @map("failed_logins")
  lockedUntil               DateTime?                @map("locked_until")
  tokenVersion              Int                      @default(0) @map("token_version")
  lastLoginAt               DateTime?                @map("last_login_at")
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")
  agencyAccess              UserAgencyAccess[]
  clientAccess              UserClientAccess[]
  teamMembers               TeamMember[]
  teamsHeaded               Team[]                   @relation("TeamHead")
  channelAgencyDealsCreated ChannelAgencyDeal[]      @relation("ChannelAgencyDealCreator")
  channelClientDealsCreated ChannelClientDeal[]      @relation("ChannelClientDealCreator")
  properties                Property[]               @relation("CreatedBy")
  propertyHistory           PropertyHistory[]        @relation("ChangedBy")
  passwordResetTokens       PasswordResetToken[]
  // Phase 3 relations
  mediaGroups               MediaGroup[]             @relation("MediaGroupCreator")
  channelMastersCreated     ChannelMaster[]          @relation("ChannelMasterCreator")
  brandsCreated             Brand[]                  @relation("BrandCreator")
  campaignsCreated          Campaign[]               @relation("CampaignCreator")
  scheduleLogs              ScheduleLog[]            @relation("ScheduleLogUploader")
  deletedScheduleLogs       ScheduleLog[]            @relation("ScheduleLogDeleter")
  uploadBatches             UploadBatch[]            @relation("UploadBatchUploader")
  scheduleLogEdits          ScheduleLogEdit[]        @relation("ScheduleLogEditor")
  notifications             Notification[]
  packagesCreated           MediaPackage[]           @relation("PackageCreator")
  packageRecipients         PackageRecipient[]       @relation("PackageRecipientUser")
  groupRevenues             GroupRevenue[]           @relation("GroupRevenueHead")
  clientRevenuesVerified    ClientRevenue[]          @relation("ClientRevenueVerifier")
  requisitions              MediaBuyingRequisition[] @relation("RequisitionRequester")

  @@map("users")
}

model Agency {
  id            Int                  @id @default(autoincrement())
  name          String               @unique
  createdAt     DateTime             @default(now()) @map("created_at")
  users         UserAgencyAccess[]
  clients       Client[]
  teams         Team[]
  // Phase 3 relations
  scheduleLogs  ScheduleLog[]
  uploadBatches UploadBatch[]
  annualTargets AgencyAnnualTarget[]
  revenues      AgencyRevenue[]

  @@map("agencies")
}

model UserAgencyAccess {
  id       Int    @id @default(autoincrement())
  userId   Int    @map("user_id")
  agencyId Int    @map("agency_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([userId, agencyId])
  @@map("user_agency_access")
}

model Client {
  id              Int                      @id @default(autoincrement())
  agencyId        Int                      @map("agency_id")
  name            String
  // Alternate spellings/variants learned from bulk-import reconciliation, so a
  // raw name mapped to this client once auto-matches on future imports (mirrors
  // ChannelMaster.aliases). Matched case-insensitively.
  aliases         String[]                 @default([])
  isActive        Boolean                  @default(true) @map("is_active")
  // Agency remuneration for the Overall Budget tab: type = COMMISSION (value is
  // a %) or AOR (value is a fixed LKR fee). Both null = not set.
  commissionType  CommissionType?          @map("commission_type")
  commissionValue Decimal?                 @map("commission_value") @db.Decimal(14, 2)
  createdAt       DateTime                 @default(now()) @map("created_at")
  agency          Agency                   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  users           UserClientAccess[]
  channels        Channel[]
  teams           TeamClient[]
  brands          Brand[]
  campaigns       Campaign[]
  scheduleLogs    ScheduleLog[]
  forecasts       MonthlyForecast[]
  budgets         MonthlyBudget[]
  channelDeals    ChannelClientDeal[]
  targets         ClientTarget[]
  revenues        ClientRevenue[]
  requisitions    MediaBuyingRequisition[]

  @@unique([agencyId, name])
  @@map("clients")
}

model UserClientAccess {
  id       Int    @id @default(autoincrement())
  userId   Int    @map("user_id")
  clientId Int    @map("client_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@map("user_client_access")
}

model Team {
  id         Int          @id @default(autoincrement())
  agencyId   Int          @map("agency_id")
  name       String
  headUserId Int?         @map("head_user_id")
  agency     Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  head       User?        @relation("TeamHead", fields: [headUserId], references: [id])
  members    TeamMember[]
  clients    TeamClient[]

  @@unique([agencyId, name])
  @@map("teams")
}

model TeamMember {
  id     Int  @id @default(autoincrement())
  teamId Int  @map("team_id")
  userId Int  @map("user_id")
  role   Role
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model TeamClient {
  id       Int    @id @default(autoincrement())
  teamId   Int    @map("team_id")
  clientId Int    @map("client_id")
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([teamId, clientId])
  @@map("team_clients")
}

// ─── Media Group ────────────────────────────────────────────────────────────

model MediaGroup {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  active         Boolean         @default(true)
  createdById    Int             @map("created_by_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  channelMasters ChannelMaster[]
  creator        User            @relation("MediaGroupCreator", fields: [createdById], references: [id])

  @@map("media_groups")
}

// ─── Channel Master (canonical channel registry) ───────────────────────────

model ChannelMaster {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique
  medium             ChannelType
  aliases            String[]            @default([])
  isActive           Boolean             @default(true) @map("is_active")
  isDeleted          Boolean             @default(false) @map("is_deleted")
  deletedAt          DateTime?           @map("deleted_at")
  deletedById        Int?                @map("deleted_by_id")
  sortOrder          Int?                @map("sort_order")
  // GENERAL channel rate card in Google Drive (General Rate Cards/<channel>/).
  // Any format (PDF/JPG/PNG/Excel/…); rateCardMimeType is used on download.
  // rateCard* = the LATEST version (for quick display/download); every upload is
  // kept as a new version in rateCardVersions (newest last) rather than replacing
  // the old file — [{ version, driveId, fileName, mimeType, size, uploadedAt }].
  rateCardDriveId    String?             @map("rate_card_drive_id")
  rateCardFileName   String?             @map("rate_card_file_name")
  rateCardMimeType   String?             @map("rate_card_mime_type")
  rateCardSize       Int?                @map("rate_card_size")
  rateCardUploadedAt DateTime?           @map("rate_card_uploaded_at")
  rateCardVersions   Json?               @map("rate_card_versions")
  mediaGroupId       Int                 @map("media_group_id")
  createdById        Int                 @map("created_by_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  channels           Channel[]
  scheduleLogs       ScheduleLog[]
  uploadBatchRows    UploadBatchRow[]
  forecasts          MonthlyForecast[]
  agencyDeals        ChannelAgencyDeal[]
  clientDeals        ChannelClientDeal[]
  commitments        ChannelCommitment[]
  mediaGroup         MediaGroup          @relation(fields: [mediaGroupId], references: [id])
  creator            User                @relation("ChannelMasterCreator", fields: [createdById], references: [id])

  @@map("channel_masters")
}

// ─── Media Buying: channel negotiation deals (discount/bonus terms) ────────

model ChannelAgencyDeal {
  id              Int           @id @default(autoincrement())
  channelMasterId Int           @map("channel_master_id")
  year            Int
  discountPct     Decimal       @map("discount_pct") @db.Decimal(5, 2)
  bonusPct        Decimal       @map("bonus_pct") @db.Decimal(5, 2)
  notes           String?
  createdById     Int           @map("created_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  channelMaster   ChannelMaster @relation(fields: [channelMasterId], references: [id], onDelete: Cascade)
  createdBy       User          @relation("ChannelAgencyDealCreator", fields: [createdById], references: [id])

  @@unique([channelMasterId, year])
  @@map("channel_agency_deals")
}

model ChannelClientDeal {
  id              Int           @id @default(autoincrement())
  channelMasterId Int           @map("channel_master_id")
  clientId        Int           @map("client_id")
  year            Int
  // How this deal's rate is expressed: DISCOUNT (discountPct, % off rate card),
  // CPRP (rateValue = negotiated cost-per-rating-point, LKR) or FLAT (rateValue =
  // flat rate, LKR). bonusPct always applies. discountPct stays 0 for CPRP/FLAT.
  rateType        String        @default("DISCOUNT") @map("rate_type")
  rateValue       Decimal?      @map("rate_value") @db.Decimal(14, 2)
  discountPct     Decimal       @map("discount_pct") @db.Decimal(5, 2)
  bonusPct        Decimal       @map("bonus_pct") @db.Decimal(5, 2)
  notes           String?
  createdById     Int           @map("created_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  channelMaster   ChannelMaster @relation(fields: [channelMasterId], references: [id], onDelete: Cascade)
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy       User          @relation("ChannelClientDealCreator", fields: [createdById], references: [id])

  @@unique([channelMasterId, clientId, year])
  @@map("channel_client_deals")
}

// ─── Channel (client-specific channel record) ──────────────────────────────

model Channel {
  id                 Int            @id @default(autoincrement())
  clientId           Int            @map("client_id")
  type               ChannelType
  name               String
  channelMasterId    Int?           @map("channel_master_id")
  // Channel's rep contact (the sales/booking person AT the channel), captured
  // when the channel is added to a client. Per-client so each client can keep
  // its own contact for the same channel.
  contactName        String?        @map("contact_name")
  contactEmail       String?        @map("contact_email")
  contactMobile      String?        @map("contact_mobile")
  // Client-specific rate card on Google Drive (Client Rate Cards/<client>/<channel>/).
  // Mirrors ChannelMaster.rateCard* (which is the GENERAL, per-channel card):
  // rateCard* = the latest version; every upload is appended to rateCardVersions.
  // Any format (PDF/JPG/PNG/Excel/…) — rateCardMimeType is used on download.
  rateCardDriveId    String?        @map("rate_card_drive_id")
  rateCardFileName   String?        @map("rate_card_file_name")
  rateCardMimeType   String?        @map("rate_card_mime_type")
  rateCardSize       Int?           @map("rate_card_size")
  rateCardUploadedAt DateTime?      @map("rate_card_uploaded_at")
  rateCardVersions   Json?          @map("rate_card_versions")
  createdAt          DateTime       @default(now()) @map("created_at")
  client             Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  channelMaster      ChannelMaster? @relation(fields: [channelMasterId], references: [id])
  properties         Property[]

  @@unique([clientId, name])
  @@map("channels")
}

// ─── Property (negotiated deal on a channel) ───────────────────────────────

model Property {
  id                   Int               @id @default(autoincrement())
  channelId            Int               @map("channel_id")
  category             String?
  name                 String
  type                 String?
  cost                 Decimal           @db.Decimal(12, 2)
  bonusValue           Decimal           @default(0) @map("bonus_value") @db.Decimal(12, 2)
  bonusCount           Int               @default(0) @map("bonus_count")
  bonusPct             Decimal?          @map("bonus_pct") @db.Decimal(6, 3)
  sponsorshipDetails   String?           @map("sponsorship_details")
  startDate            DateTime?         @map("start_date") @db.Date
  endDate              DateTime?         @map("end_date") @db.Date
  notes                String?
  // Optional evaluation document (PDF/Excel) stored on Google Drive; only the
  // Drive file id + metadata live in the DB (mirrors ChannelMaster.rateCard*).
  evaluationDriveId    String?           @map("evaluation_drive_id")
  evaluationFileName   String?           @map("evaluation_file_name")
  evaluationMimeType   String?           @map("evaluation_mime_type")
  evaluationSize       Int?              @map("evaluation_size")
  evaluationUploadedAt DateTime?         @map("evaluation_uploaded_at")
  createdBy            Int               @map("created_by")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  channel              Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  creator              User              @relation("CreatedBy", fields: [createdBy], references: [id])
  history              PropertyHistory[]

  @@map("properties")
}

model PropertyCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("property_categories")
}

model PropertyHistory {
  id             Int      @id @default(autoincrement())
  propertyId     Int      @map("property_id")
  changedBy      Int      @map("changed_by")
  previousValues Json     @map("previous_values")
  newValues      Json     @map("new_values")
  changeNote     String   @map("change_note")
  changedAt      DateTime @default(now()) @map("changed_at")
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  changer        User     @relation("ChangedBy", fields: [changedBy], references: [id])

  @@map("property_history")
}

// ─── Brand + Campaign ───────────────────────────────────────────────────────

model Brand {
  id           Int           @id @default(autoincrement())
  clientId     Int           @map("client_id")
  name         String
  active       Boolean       @default(true)
  createdById  Int           @map("created_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator      User          @relation("BrandCreator", fields: [createdById], references: [id])
  campaigns    Campaign[]
  scheduleLogs ScheduleLog[]

  @@unique([clientId, name])
  @@map("brands")
}

model Campaign {
  id           Int           @id @default(autoincrement())
  brandId      Int           @map("brand_id")
  clientId     Int           @map("client_id")
  name         String
  active       Boolean       @default(true)
  createdById  Int           @map("created_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  brand        Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator      User          @relation("CampaignCreator", fields: [createdById], references: [id])
  scheduleLogs ScheduleLog[]

  @@unique([brandId, name])
  @@map("campaigns")
}

// ─── Schedule Log (monthly execution record) ────────────────────────────────

model ScheduleLog {
  id                    Int       @id @default(autoincrement())
  agencyId              Int       @map("agency_id")
  clientId              Int       @map("client_id")
  brandId               Int?      @map("brand_id")
  campaignId            Int?      @map("campaign_id")
  uploadedById          Int       @map("uploaded_by_id")
  uploadBatchId         Int?      @map("upload_batch_id")
  roNumber              String    @map("ro_number")
  scheduleMonth         String    @map("schedule_month")
  invoiceMonth          String    @map("invoice_month")
  channelMasterId       Int       @map("channel_master_id")
  medium                String
  mediaGroup            String    @map("media_group")
  brandName             String?   @map("brand_name")
  scheduleValue         Decimal   @map("schedule_value") @db.Decimal(14, 2)
  scheduleValueWithVat  Decimal   @map("schedule_value_with_vat") @db.Decimal(14, 2)
  // Agency commission snapshotted at entry (immutable) for the Profit tab.
  // type = COMMISSION (rate is a %) or AOR (rate holds the fixed LKR fee); null
  // when the client had no commission set. commissionBackfilled flags rows whose
  // snapshot was filled in retroactively rather than captured at true entry time.
  commissionTypeAtEntry String?   @map("commission_type_at_entry")
  commissionRateAtEntry Decimal?  @map("commission_rate_at_entry") @db.Decimal(14, 2)
  commissionBackfilled  Boolean   @default(false) @map("commission_backfilled")
  // Extra spreadsheet columns kept verbatim on bulk import (Invoice Value, CAG/
  // AOR %, station & agency invoice numbers, dates, Payment Received, etc.) that
  // the system does not compute with — retained for the record and re-exportable.
  // Keyed by original column header. Not used in any aggregation.
  importExtra           Json?     @map("import_extra")
  propertyId            Int?      @map("property_id")
  isDeleted             Boolean   @default(false) @map("is_deleted")
  deletedById           Int?      @map("deleted_by_id")
  deletedAt             DateTime? @map("deleted_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  agency         Agency            @relation(fields: [agencyId], references: [id])
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  brand          Brand?            @relation(fields: [brandId], references: [id])
  campaign       Campaign?         @relation(fields: [campaignId], references: [id])
  uploader       User              @relation("ScheduleLogUploader", fields: [uploadedById], references: [id])
  uploadBatch    UploadBatch?      @relation(fields: [uploadBatchId], references: [id])
  channelMaster  ChannelMaster     @relation(fields: [channelMasterId], references: [id])
  deletedBy      User?             @relation("ScheduleLogDeleter", fields: [deletedById], references: [id])
  uploadBatchRow UploadBatchRow[]
  edits          ScheduleLogEdit[]

  @@map("schedule_logs")
}

// ─── Upload Batch ────────────────────────────────────────────────────────────

model UploadBatch {
  id             Int          @id @default(autoincrement())
  agencyId       Int          @map("agency_id")
  clientIds      Int[]        @map("client_ids")
  scheduleMonth  String       @map("schedule_month")
  uploadedById   Int          @map("uploaded_by_id")
  fileName       String       @map("file_name")
  totalRows      Int          @map("total_rows")
  successfulRows Int          @default(0) @map("successful_rows")
  failedRows     Int          @default(0) @map("failed_rows")
  status         UploadStatus
  createdAt      DateTime     @default(now()) @map("created_at")

  agency       Agency           @relation(fields: [agencyId], references: [id])
  uploader     User             @relation("UploadBatchUploader", fields: [uploadedById], references: [id])
  rows         UploadBatchRow[]
  scheduleLogs ScheduleLog[]

  @@map("upload_batches")
}

// ─── Upload Batch Row ────────────────────────────────────────────────────────

model UploadBatchRow {
  id                Int       @id @default(autoincrement())
  batchId           Int       @map("batch_id")
  rowNumber         Int       @map("row_number")
  rawData           Json      @map("raw_data")
  resolvedData      Json?     @map("resolved_data")
  channelRaw        String?   @map("channel_raw")
  channelResolvedId Int?      @map("channel_resolved_id")
  monthRaw          String?   @map("month_raw")
  monthResolved     String?   @map("month_resolved")
  status            RowStatus
  reviewNote        String?   @map("review_note")
  scheduleLogId     Int?      @map("schedule_log_id")

  batch           UploadBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  channelResolved ChannelMaster? @relation(fields: [channelResolvedId], references: [id])
  scheduleLog     ScheduleLog?   @relation(fields: [scheduleLogId], references: [id])

  @@map("upload_batch_rows")
}

// ─── Schedule Log Edit ───────────────────────────────────────────────────────

model ScheduleLogEdit {
  id             Int      @id @default(autoincrement())
  scheduleLogId  Int      @map("schedule_log_id")
  editedById     Int      @map("edited_by_id")
  previousValues Json     @map("previous_values")
  newValues      Json     @map("new_values")
  editNote       String   @map("edit_note")
  editedAt       DateTime @default(now()) @map("edited_at")

  scheduleLog ScheduleLog @relation(fields: [scheduleLogId], references: [id], onDelete: Cascade)
  editor      User        @relation("ScheduleLogEditor", fields: [editedById], references: [id])

  @@map("schedule_log_edits")
}

// ─── Notifications ──────────────────────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String
  title     String
  message   String
  month     String?
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── Forecasting & Targets ──────────────────────────────────────────────────

model AnnualTarget {
  id                  Int      @id @default(autoincrement())
  year                Int      @unique
  totalTargetMillions Decimal  @map("total_target_millions") @db.Decimal(14, 2)
  remoteMonth         Int?     @map("remote_month") // null = auto (latest month with actuals)
  createdById         Int?     @map("created_by_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("annual_targets")
}

// Per-agency annual target (LKR millions), one per agency per year. Drives the
// agency-wise Annual Achievement chart on Spend Analytics (distinct from the
// company-wide AnnualTarget that feeds the Executive Dashboard).
model AgencyAnnualTarget {
  id                  Int      @id @default(autoincrement())
  agencyId            Int      @map("agency_id")
  year                Int
  totalTargetMillions Decimal  @map("total_target_millions") @db.Decimal(14, 2)
  createdById         Int?     @map("created_by_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, year])
  @@index([year])
  @@map("agency_annual_targets")
}

model MonthlyForecast {
  id              Int      @id @default(autoincrement())
  year            Int
  month           Int // 1=Jan
  clientId        Int      @map("client_id")
  channelMasterId Int      @map("channel_master_id")
  agencyId        Int      @map("agency_id")
  // Stored in millions, but with 6 decimal places so it represents the exact
  // full-LKR amount the group head entered (1 LKR = 0.000001 M). Decimal(_,2)
  // only gave 10,000-LKR precision, silently rounding e.g. 1,705,000 → 1,710,000.
  amountMillions  Decimal  @map("amount_millions") @db.Decimal(18, 6)
  notes           String?
  submittedById   Int      @map("submitted_by_id")
  submittedAt     DateTime @default(now()) @map("submitted_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  channelMaster ChannelMaster @relation(fields: [channelMasterId], references: [id])

  @@unique([year, month, clientId, channelMasterId])
  @@index([year, month])
  @@map("monthly_forecasts")
}

// Overall Budget worksheet, one row per client per month (the month rolls on
// the 15th, mirroring MonthlyForecast). "Actual" is NOT stored here — it is
// derived live from that client's MonthlyForecast total. Only the group-head
// entered figures live here: bestAmount and billingLastMonth (both full LKR).
model MonthlyBudget {
  id               Int      @id @default(autoincrement())
  year             Int
  month            Int // 1=Jan
  clientId         Int      @map("client_id")
  agencyId         Int      @map("agency_id")
  bestAmount       Decimal? @map("best_amount") @db.Decimal(16, 2)
  billingLastMonth Decimal? @map("billing_last_month") @db.Decimal(16, 2)
  submittedById    Int      @map("submitted_by_id")
  submittedAt      DateTime @default(now()) @map("submitted_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([year, month, clientId])
  @@index([year, month])
  @@map("monthly_budgets")
}

// Admin-entered Revenue Contribution per group head, per month. Drives the right
// donut of the Executive Dashboard's Group Contribution card (the left donut is
// derived from schedule logs). One amount (full LKR) per GROUP_HEAD user per month.
model GroupRevenue {
  id          Int      @id @default(autoincrement())
  year        Int
  month       Int // 1=Jan
  headUserId  Int      @map("head_user_id")
  amount      Decimal  @db.Decimal(16, 2)
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  head User @relation("GroupRevenueHead", fields: [headUserId], references: [id], onDelete: Cascade)

  @@unique([year, month, headUserId])
  @@index([year, month])
  @@map("group_revenues")
}

// Admin-entered revenue per CLIENT per month. `amount` = "Revenue (LKR)" (a Hub
// head's revenue total = the sum of their clients' `amount` when any exist,
// rolled up in the Executive Dashboard Revenue Contribution donut; otherwise the
// direct GroupRevenue figure for that head is used). `revenueFromFinance` = the
// figure Finance reports for that client/month; the client's group head then
// VERIFIES it on the Spend Analytics → Rev Verification screen — confirming it
// (verifyStatus=VERIFIED, verifyReason auto-set to "Confirmed with the finance")
// or disputing it with a corrected amount + reason (verifyStatus=DISPUTED). A
// wrongly-entered confirm/dispute can be RESET back to PENDING (clears
// verifiedAmount/reason, keeps revenueFromFinance) by the group head on that
// screen or by the admin from Group Revenue → Revenue by Client — both via the
// `reset` action on POST /api/revenue/verification. A row with both amounts blank is cleared.
model ClientRevenue {
  id                 Int                 @id @default(autoincrement())
  year               Int
  month              Int // 1=Jan
  clientId           Int                 @map("client_id")
  amount             Decimal?            @db.Decimal(16, 2)
  revenueFromFinance Decimal?            @map("revenue_from_finance") @db.Decimal(16, 2)
  verifyStatus       RevenueVerifyStatus @default(PENDING) @map("verify_status")
  verifiedAmount     Decimal?            @map("verified_amount") @db.Decimal(16, 2)
  verifyReason       String?             @map("verify_reason")
  verifiedById       Int?                @map("verified_by_id")
  verifiedAt         DateTime?           @map("verified_at")
  createdById        Int?                @map("created_by_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  verifier User?  @relation("ClientRevenueVerifier", fields: [verifiedById], references: [id])

  @@unique([year, month, clientId])
  @@index([year, month])
  @@map("client_revenues")
}

// Admin-entered actual billing/revenue per AGENCY per month (full LKR). Drives
// the agency-wise "Business Units Contribution" Revenue donut on the Executive
// Dashboard, and its per-month TOTAL is mirrored into MonthlyBilling so the
// Revenue Achievement chart uses the same figure ("use total as that month").
model AgencyRevenue {
  id          Int      @id @default(autoincrement())
  year        Int
  month       Int // 1=Jan
  agencyId    Int      @map("agency_id")
  amount      Decimal  @db.Decimal(16, 2)
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([year, month, agencyId])
  @@index([year, month])
  @@map("agency_revenues")
}

// Two commitment types (per channel):
//  MONTHLY - `monthlyAmount` is a flat per-month target; each active month is
//            judged on its own (met = that month's spend ≥ target → green/red).
//  ANNUAL  - `totalAmount` is the total for the whole period; the monthly pace =
//            total ÷ months-in-period, and it is judged cumulatively (pacing to
//            date), not month-by-month.
enum CommitmentType {
  MONTHLY
  ANNUAL
}

// Per-channel commitment over a MONTH-GRAIN PERIOD (can cross calendar years,
// e.g. Mar 2026 → Apr 2027). One active commitment per channel (enforced in app
// code, not a DB unique, so a schema push never fails on legacy duplicates).
// Cumulative target within a viewed year = monthly pace × the count of the
// channel's active months in that year up to the latest data month. Achievement
// is live ScheduleLog spend on those months. Legacy `year`/`yearlyAmount`
// (pre-period) are kept nullable and back-filled into the period fields by
// seed.js (year → Jan-Dec, MONTHLY, monthlyAmount = yearlyAmount / 12). Drives
// the Executive Dashboard's "Channel Commitments" tracker.
model ChannelCommitment {
  id              Int            @id @default(autoincrement())
  channelMasterId Int            @map("channel_master_id")
  type            CommitmentType @default(MONTHLY)
  startYear       Int?           @map("start_year")
  startMonth      Int?           @map("start_month") // 1=Jan
  endYear         Int?           @map("end_year")
  endMonth        Int?           @map("end_month") // 1=Jan
  monthlyAmount   Decimal?       @map("monthly_amount") @db.Decimal(16, 2) // MONTHLY type
  totalAmount     Decimal?       @map("total_amount") @db.Decimal(16, 2) // ANNUAL type (total for the period)
  // legacy pre-period columns (nullable, back-filled by seed.js, then unused)
  year            Int?
  yearlyAmount    Decimal?       @map("yearly_amount") @db.Decimal(16, 2)
  createdById     Int?           @map("created_by_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  channelMaster ChannelMaster @relation(fields: [channelMasterId], references: [id], onDelete: Cascade)

  @@index([channelMasterId])
  @@index([startYear])
  @@index([endYear])
  @@map("channel_commitments")
}

// A single deal spanning MULTIPLE channels (typically one media-group buy, e.g.
// Hiru FM + Sooriyan FM + Sun FM). ONE target for the whole group; achievement =
// the COMBINED ScheduleLog spend of every member channel over the committed
// period. Same period/type semantics as ChannelCommitment. Shown as one combined
// row in the Executive Dashboard's Channel Commitments tracker.
model ChannelCommitmentGroup {
  id               Int            @id @default(autoincrement())
  name             String
  type             CommitmentType @default(MONTHLY)
  startYear        Int            @map("start_year")
  startMonth       Int            @map("start_month") // 1=Jan
  endYear          Int            @map("end_year")
  endMonth         Int            @map("end_month") // 1=Jan
  monthlyAmount    Decimal?       @map("monthly_amount") @db.Decimal(16, 2) // MONTHLY type
  totalAmount      Decimal?       @map("total_amount") @db.Decimal(16, 2) // ANNUAL type (total for the period)
  channelMasterIds Int[]          @map("channel_master_ids") // member channels
  createdById      Int?           @map("created_by_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([startYear])
  @@index([endYear])
  @@map("channel_commitment_groups")
}

// Admin-entered company-wide actual billing (full LKR), one figure per month.
// Summed Jan→latest entered month = the green "Achievement" bar of the Executive
// Dashboard's Revenue Achievement chart (target = AnnualTarget ÷ 12 × months).
model MonthlyBilling {
  id          Int      @id @default(autoincrement())
  year        Int
  month       Int // 1=Jan
  amount      Decimal  @db.Decimal(16, 2)
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([year, month])
  @@index([year])
  @@map("monthly_billings")
}

// Admin-entered monthly AOR (Agency of Record) revenue lines. Each row is one
// channel's AOR fee for a given month (channel name + amount + optional reason),
// entered in Admin → AOR. They are summed per month and stacked on top of the
// billing-revenue bars in Revenue → "Revenue by billing", so on that tab
// Total Rev = Billing Revenue + AOR Revenue. Company-wide (no client/agency
// link) — year/month scoped only. SUPER_ADMIN only.
model AorRevenue {
  id          Int      @id @default(autoincrement())
  year        Int
  month       Int // 1=Jan
  channel     String
  amount      Decimal  @db.Decimal(16, 2)
  reason      String?
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([year, month])
  @@map("aor_revenues")
}

// Admin-entered company-wide monthly REVENUE TARGET (full LKR), one per month
// (Jan, Feb, ...). Their cumulative sum Jan→the latest billed month is the yellow
// "Target" bar of the Executive Dashboard's Revenue Achievement chart. Entered in
// Admin → Group Revenue. When no monthly targets exist for a year, the chart
// falls back to the prorated AnnualTarget (÷ 12 × months).
model MonthlyRevenueTarget {
  id          Int      @id @default(autoincrement())
  year        Int
  month       Int // 1=Jan
  amount      Decimal  @db.Decimal(16, 2)
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([year, month])
  @@index([year])
  @@map("monthly_revenue_targets")
}

// Admin-entered single MONTHLY revenue target that applies to EVERY month of the
// year (full LKR). The Revenue Achievement Target bar = monthlyAmount × the
// number of months elapsed (Jan→latest billed month), e.g. 10 → 60 at June. One
// row per year. Takes precedence over the per-month MonthlyRevenueTarget rows and
// the prorated AnnualTarget fallback.
model YearRevenueTarget {
  id            Int      @id @default(autoincrement())
  year          Int      @unique
  monthlyAmount Decimal  @map("monthly_amount") @db.Decimal(16, 2)
  createdById   Int?     @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("year_revenue_targets")
}

// Admin-entered yearly spend target per client (full LKR). "Achieved" is the
// client's actual ScheduleLog spend for that year. Drives the Spend Analytics
// client-target section and the Client Dashboard target progress. One per
// client per year.
model ClientTarget {
  id          Int      @id @default(autoincrement())
  clientId    Int      @map("client_id")
  year        Int
  amount      Decimal  @db.Decimal(16, 2)
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, year])
  @@index([year])
  @@map("client_targets")
}

model ClientRequest {
  id            Int       @id @default(autoincrement())
  requestedById Int       @map("requested_by_id")
  clientName    String    @map("client_name")
  agencyId      Int?      @map("agency_id")
  notes         String?
  status        String    @default("pending") // pending | approved | rejected
  reviewedById  Int?      @map("reviewed_by_id")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("client_requests")
}

model ChannelRequest {
  id            Int         @id @default(autoincrement())
  requestedById Int         @map("requested_by_id")
  channelName   String      @map("channel_name")
  category      ChannelType
  notes         String?
  status        String      @default("pending") // pending | approved | rejected
  reviewedById  Int?        @map("reviewed_by_id")
  reviewedAt    DateTime?   @map("reviewed_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("channel_requests")
}

// A bulk-import row held back because its client and/or channel is a pending
// "request new" (see import reconciliation). When the referenced ClientRequest /
// ChannelRequest is approved (which creates the entity), the row's dependency is
// cleared; once BOTH deps are clear the row is inserted as a ScheduleLog and the
// held row deleted. `rowData` is the reconciled parsed row (names already mapped
// for everything except the pending new entity).
model PendingImportRow {
  id           Int      @id @default(autoincrement())
  fileName     String   @map("file_name")
  rowData      Json     @map("row_data")
  clientReqId  Int?     @map("client_req_id") // waiting on this ClientRequest
  channelReqId Int?     @map("channel_req_id") // waiting on this ChannelRequest
  createdById  Int      @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([clientReqId])
  @@index([channelReqId])
  @@map("pending_import_rows")
}

// ─── Auth ───────────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─── Media Packages ───────────────────────────────────────────────────────────

// Media Buying Requisition (MBR) — a Desk/Hub request to the buying unit for a
// media plan. Free-form per-medium detail is kept as JSON so the form can grow.
model MediaBuyingRequisition {
  id               Int       @id @default(autoincrement())
  clientId         Int       @map("client_id")
  requestedById    Int       @map("requested_by_id")
  brandCampaign    String    @map("brand_campaign")
  targetGroup      String?   @map("target_group")
  campaignStart    DateTime? @map("campaign_start")
  campaignEnd      DateTime? @map("campaign_end")
  budgetPct        Int?      @map("budget_pct") // 100 or 85
  mediums          String[]  @default([]) // ['TV','RADIO','PRINT',...]
  stations         Json? // { TV: '...', RADIO: '...', PRINT: '...' }
  buyingProperty   String?   @map("buying_property") // sponsorships / key integrations
  deliverables     Json? // { TV, RADIO, PRINT: '...' }
  daypartMandates  Json?     @map("daypart_mandates") // { TV, RADIO: '...' }
  otherNotes       String?   @map("other_notes")
  discussionPoints String?   @map("discussion_points")
  deadlineType     String?   @map("deadline_type") // 'annual' | 'campaign-special' | 'new-client'
  status           String    @default("SUBMITTED")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requester        User      @relation("RequisitionRequester", fields: [requestedById], references: [id])

  @@index([clientId])
  @@index([requestedById])
  @@map("media_buying_requisitions")
}

model MediaPackage {
  id          Int                @id @default(autoincrement())
  name        String
  category    String?
  emailIntro  String             @map("email_intro")
  deadline    DateTime? // proposal deadline; past it the package auto-deactivates
  isActive    Boolean            @default(true) @map("is_active")
  createdById Int                @map("created_by_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  creator     User               @relation("PackageCreator", fields: [createdById], references: [id])
  lineItems   PackageLineItem[]
  recipients  PackageRecipient[]

  @@map("media_packages")
}

model PackageLineItem {
  id        Int          @id @default(autoincrement())
  packageId Int          @map("package_id")
  label     String
  rate      Decimal      @db.Decimal(12, 2)
  sortOrder Int          @default(0) @map("sort_order")
  package   MediaPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_line_items")
}

model PackageRecipient {
  id                  Int              @id @default(autoincrement())
  packageId           Int              @map("package_id")
  userId              Int              @map("user_id")
  tokenHash           String?          @unique @map("token_hash")
  expiresAt           DateTime?        @map("expires_at")
  sentAt              DateTime?        @map("sent_at")
  respondedAt         DateTime?        @map("responded_at")
  interest            PackageInterest?
  budgetNote          String?          @map("budget_note")
  clientName          String?          @map("client_name")
  interestedClientIds Int[]            @default([]) @map("interested_client_ids")
  notes               String?
  followUp            ResponseFollowUp @default(PENDING) @map("follow_up")
  createdAt           DateTime         @default(now()) @map("created_at")
  package             MediaPackage     @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user                User             @relation("PackageRecipientUser", fields: [userId], references: [id])

  @@map("package_recipients")
}
