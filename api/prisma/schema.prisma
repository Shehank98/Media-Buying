generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  GROUP_HEAD
  PLANNER
}

enum ChannelType {
  TV
  RADIO
  PRINT
  DIGITAL
  CINEMA
  OOH
}

enum UploadStatus {
  PENDING
  PROCESSING
  REVIEW
  COMPLETE
  FAILED
}

enum RowStatus {
  OK
  NEEDS_REVIEW
  FAILED
}

enum PackageInterest {
  INTERESTED
  NOT_INTERESTED
  NEGOTIATE
}

enum ResponseFollowUp {
  PENDING
  FOLLOWED_UP
  BOOKED
  CLOSED
}

// A client's negotiated agency remuneration: either a commission percentage
// (COMMISSION, value = %) or a fixed Agency-of-Record fee (AOR, value = LKR).
enum CommissionType {
  COMMISSION
  AOR
}

model User {
  id                    Int                  @id @default(autoincrement())
  email                 String               @unique
  passwordHash          String               @map("password_hash")
  name                  String
  role                  Role
  mustChangePassword    Boolean              @default(true) @map("must_change_password")
  pageAccess            String[]             @default([]) @map("page_access")
  canExport             Boolean              @default(true) @map("can_export")
  readOnly              Boolean              @default(false) @map("read_only")
  failedLogins          Int                  @default(0) @map("failed_logins")
  lockedUntil           DateTime?            @map("locked_until")
  tokenVersion          Int                  @default(0) @map("token_version")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  agencyAccess          UserAgencyAccess[]
  clientAccess          UserClientAccess[]
  teamMembers           TeamMember[]
  teamsHeaded           Team[]               @relation("TeamHead")
  channelAgencyDealsCreated ChannelAgencyDeal[] @relation("ChannelAgencyDealCreator")
  channelClientDealsCreated ChannelClientDeal[] @relation("ChannelClientDealCreator")
  properties            Property[]           @relation("CreatedBy")
  propertyHistory       PropertyHistory[]    @relation("ChangedBy")
  passwordResetTokens   PasswordResetToken[]
  // Phase 3 relations
  mediaGroups           MediaGroup[]         @relation("MediaGroupCreator")
  channelMastersCreated ChannelMaster[]      @relation("ChannelMasterCreator")
  brandsCreated         Brand[]              @relation("BrandCreator")
  campaignsCreated      Campaign[]           @relation("CampaignCreator")
  scheduleLogs          ScheduleLog[]        @relation("ScheduleLogUploader")
  deletedScheduleLogs   ScheduleLog[]        @relation("ScheduleLogDeleter")
  uploadBatches         UploadBatch[]        @relation("UploadBatchUploader")
  scheduleLogEdits      ScheduleLogEdit[]    @relation("ScheduleLogEditor")
  notifications         Notification[]
  packagesCreated       MediaPackage[]       @relation("PackageCreator")
  packageRecipients     PackageRecipient[]   @relation("PackageRecipientUser")

  @@map("users")
}

model Agency {
  id            Int                @id @default(autoincrement())
  name          String             @unique
  createdAt     DateTime           @default(now()) @map("created_at")
  users         UserAgencyAccess[]
  clients       Client[]
  teams         Team[]
  // Phase 3 relations
  scheduleLogs  ScheduleLog[]
  uploadBatches UploadBatch[]

  @@map("agencies")
}

model UserAgencyAccess {
  id       Int    @id @default(autoincrement())
  userId   Int    @map("user_id")
  agencyId Int    @map("agency_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([userId, agencyId])
  @@map("user_agency_access")
}

model Client {
  id              Int                @id @default(autoincrement())
  agencyId        Int                @map("agency_id")
  name            String
  isActive        Boolean            @default(true) @map("is_active")
  // Agency remuneration for the Overall Budget tab: type = COMMISSION (value is
  // a %) or AOR (value is a fixed LKR fee). Both null = not set.
  commissionType  CommissionType?    @map("commission_type")
  commissionValue Decimal?           @map("commission_value") @db.Decimal(14, 2)
  createdAt       DateTime           @default(now()) @map("created_at")
  agency          Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  users           UserClientAccess[]
  channels        Channel[]
  teams           TeamClient[]
  brands          Brand[]
  campaigns       Campaign[]
  scheduleLogs    ScheduleLog[]
  forecasts       MonthlyForecast[]
  budgets         MonthlyBudget[]
  channelDeals    ChannelClientDeal[]

  @@unique([agencyId, name])
  @@map("clients")
}

model UserClientAccess {
  id       Int    @id @default(autoincrement())
  userId   Int    @map("user_id")
  clientId Int    @map("client_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@map("user_client_access")
}

model Team {
  id         Int          @id @default(autoincrement())
  agencyId   Int          @map("agency_id")
  name       String
  headUserId Int?         @map("head_user_id")
  agency     Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  head       User?        @relation("TeamHead", fields: [headUserId], references: [id])
  members    TeamMember[]
  clients    TeamClient[]

  @@unique([agencyId, name])
  @@map("teams")
}

model TeamMember {
  id     Int  @id @default(autoincrement())
  teamId Int  @map("team_id")
  userId Int  @map("user_id")
  role   Role
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model TeamClient {
  id       Int    @id @default(autoincrement())
  teamId   Int    @map("team_id")
  clientId Int    @map("client_id")
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([teamId, clientId])
  @@map("team_clients")
}

// ─── Media Group ────────────────────────────────────────────────────────────

model MediaGroup {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  active         Boolean         @default(true)
  createdById    Int             @map("created_by_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  channelMasters ChannelMaster[]
  creator        User            @relation("MediaGroupCreator", fields: [createdById], references: [id])

  @@map("media_groups")
}

// ─── Channel Master (canonical channel registry) ───────────────────────────

model ChannelMaster {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  medium          ChannelType
  aliases         String[]         @default([])
  isActive        Boolean          @default(true) @map("is_active")
  sortOrder       Int?             @map("sort_order")
  mediaGroupId    Int              @map("media_group_id")
  createdById     Int              @map("created_by_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  channels        Channel[]
  scheduleLogs    ScheduleLog[]
  uploadBatchRows UploadBatchRow[]
  forecasts       MonthlyForecast[]
  agencyDeals     ChannelAgencyDeal[]
  clientDeals     ChannelClientDeal[]
  mediaGroup      MediaGroup       @relation(fields: [mediaGroupId], references: [id])
  creator         User             @relation("ChannelMasterCreator", fields: [createdById], references: [id])

  @@map("channel_masters")
}

// ─── Media Buying: channel negotiation deals (discount/bonus terms) ────────

model ChannelAgencyDeal {
  id              Int      @id @default(autoincrement())
  channelMasterId Int      @map("channel_master_id")
  year            Int
  discountPct     Decimal  @map("discount_pct") @db.Decimal(5, 2)
  bonusPct        Decimal  @map("bonus_pct") @db.Decimal(5, 2)
  notes           String?
  createdById     Int      @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  channelMaster   ChannelMaster @relation(fields: [channelMasterId], references: [id], onDelete: Cascade)
  createdBy       User          @relation("ChannelAgencyDealCreator", fields: [createdById], references: [id])

  @@unique([channelMasterId, year])
  @@map("channel_agency_deals")
}

model ChannelClientDeal {
  id              Int      @id @default(autoincrement())
  channelMasterId Int      @map("channel_master_id")
  clientId        Int      @map("client_id")
  year            Int
  discountPct     Decimal  @map("discount_pct") @db.Decimal(5, 2)
  bonusPct        Decimal  @map("bonus_pct") @db.Decimal(5, 2)
  notes           String?
  createdById     Int      @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  channelMaster   ChannelMaster @relation(fields: [channelMasterId], references: [id], onDelete: Cascade)
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy       User          @relation("ChannelClientDealCreator", fields: [createdById], references: [id])

  @@unique([channelMasterId, clientId, year])
  @@map("channel_client_deals")
}

// ─── Channel (client-specific channel record) ──────────────────────────────

model Channel {
  id              Int            @id @default(autoincrement())
  clientId        Int            @map("client_id")
  type            ChannelType
  name            String
  channelMasterId Int?           @map("channel_master_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  channelMaster   ChannelMaster? @relation(fields: [channelMasterId], references: [id])
  properties      Property[]

  @@unique([clientId, name])
  @@map("channels")
}

// ─── Property (negotiated deal on a channel) ───────────────────────────────

model Property {
  id                 Int               @id @default(autoincrement())
  channelId          Int               @map("channel_id")
  category           String?
  name               String
  type               String?
  cost               Decimal           @db.Decimal(12, 2)
  bonusValue         Decimal           @default(0) @map("bonus_value") @db.Decimal(12, 2)
  bonusCount         Int               @default(0) @map("bonus_count")
  bonusPct           Decimal?          @map("bonus_pct") @db.Decimal(6, 3)
  sponsorshipDetails String?           @map("sponsorship_details")
  startDate          DateTime?         @map("start_date") @db.Date
  endDate            DateTime?         @map("end_date") @db.Date
  notes              String?
  createdBy          Int               @map("created_by")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  channel            Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  creator            User              @relation("CreatedBy", fields: [createdBy], references: [id])
  history            PropertyHistory[]

  @@map("properties")
}

model PropertyCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("property_categories")
}

model PropertyHistory {
  id             Int      @id @default(autoincrement())
  propertyId     Int      @map("property_id")
  changedBy      Int      @map("changed_by")
  previousValues Json     @map("previous_values")
  newValues      Json     @map("new_values")
  changeNote     String   @map("change_note")
  changedAt      DateTime @default(now()) @map("changed_at")
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  changer        User     @relation("ChangedBy", fields: [changedBy], references: [id])

  @@map("property_history")
}

// ─── Brand + Campaign ───────────────────────────────────────────────────────

model Brand {
  id           Int           @id @default(autoincrement())
  clientId     Int           @map("client_id")
  name         String
  active       Boolean       @default(true)
  createdById  Int           @map("created_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator      User          @relation("BrandCreator", fields: [createdById], references: [id])
  campaigns    Campaign[]
  scheduleLogs ScheduleLog[]

  @@unique([clientId, name])
  @@map("brands")
}

model Campaign {
  id           Int           @id @default(autoincrement())
  brandId      Int           @map("brand_id")
  clientId     Int           @map("client_id")
  name         String
  active       Boolean       @default(true)
  createdById  Int           @map("created_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  brand        Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator      User          @relation("CampaignCreator", fields: [createdById], references: [id])
  scheduleLogs ScheduleLog[]

  @@unique([brandId, name])
  @@map("campaigns")
}

// ─── Schedule Log (monthly execution record) ────────────────────────────────

model ScheduleLog {
  id                   Int       @id @default(autoincrement())
  agencyId             Int       @map("agency_id")
  clientId             Int       @map("client_id")
  brandId              Int?      @map("brand_id")
  campaignId           Int?      @map("campaign_id")
  uploadedById         Int       @map("uploaded_by_id")
  uploadBatchId        Int?      @map("upload_batch_id")
  roNumber             String    @map("ro_number")
  scheduleMonth        String    @map("schedule_month")
  invoiceMonth         String    @map("invoice_month")
  channelMasterId      Int       @map("channel_master_id")
  medium               String
  mediaGroup           String    @map("media_group")
  brandName            String?   @map("brand_name")
  scheduleValue        Decimal   @map("schedule_value") @db.Decimal(14, 2)
  scheduleValueWithVat Decimal   @map("schedule_value_with_vat") @db.Decimal(14, 2)
  propertyId           Int?      @map("property_id")
  isDeleted            Boolean   @default(false) @map("is_deleted")
  deletedById          Int?      @map("deleted_by_id")
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  agency         Agency            @relation(fields: [agencyId], references: [id])
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  brand          Brand?            @relation(fields: [brandId], references: [id])
  campaign       Campaign?         @relation(fields: [campaignId], references: [id])
  uploader       User              @relation("ScheduleLogUploader", fields: [uploadedById], references: [id])
  uploadBatch    UploadBatch?      @relation(fields: [uploadBatchId], references: [id])
  channelMaster  ChannelMaster     @relation(fields: [channelMasterId], references: [id])
  deletedBy      User?             @relation("ScheduleLogDeleter", fields: [deletedById], references: [id])
  uploadBatchRow UploadBatchRow[]
  edits          ScheduleLogEdit[]

  @@map("schedule_logs")
}

// ─── Upload Batch ────────────────────────────────────────────────────────────

model UploadBatch {
  id             Int          @id @default(autoincrement())
  agencyId       Int          @map("agency_id")
  clientIds      Int[]        @map("client_ids")
  scheduleMonth  String       @map("schedule_month")
  uploadedById   Int          @map("uploaded_by_id")
  fileName       String       @map("file_name")
  totalRows      Int          @map("total_rows")
  successfulRows Int          @default(0) @map("successful_rows")
  failedRows     Int          @default(0) @map("failed_rows")
  status         UploadStatus
  createdAt      DateTime     @default(now()) @map("created_at")

  agency       Agency           @relation(fields: [agencyId], references: [id])
  uploader     User             @relation("UploadBatchUploader", fields: [uploadedById], references: [id])
  rows         UploadBatchRow[]
  scheduleLogs ScheduleLog[]

  @@map("upload_batches")
}

// ─── Upload Batch Row ────────────────────────────────────────────────────────

model UploadBatchRow {
  id                Int       @id @default(autoincrement())
  batchId           Int       @map("batch_id")
  rowNumber         Int       @map("row_number")
  rawData           Json      @map("raw_data")
  resolvedData      Json?     @map("resolved_data")
  channelRaw        String?   @map("channel_raw")
  channelResolvedId Int?      @map("channel_resolved_id")
  monthRaw          String?   @map("month_raw")
  monthResolved     String?   @map("month_resolved")
  status            RowStatus
  reviewNote        String?   @map("review_note")
  scheduleLogId     Int?      @map("schedule_log_id")

  batch           UploadBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  channelResolved ChannelMaster? @relation(fields: [channelResolvedId], references: [id])
  scheduleLog     ScheduleLog?   @relation(fields: [scheduleLogId], references: [id])

  @@map("upload_batch_rows")
}

// ─── Schedule Log Edit ───────────────────────────────────────────────────────

model ScheduleLogEdit {
  id             Int      @id @default(autoincrement())
  scheduleLogId  Int      @map("schedule_log_id")
  editedById     Int      @map("edited_by_id")
  previousValues Json     @map("previous_values")
  newValues      Json     @map("new_values")
  editNote       String   @map("edit_note")
  editedAt       DateTime @default(now()) @map("edited_at")

  scheduleLog ScheduleLog @relation(fields: [scheduleLogId], references: [id], onDelete: Cascade)
  editor      User        @relation("ScheduleLogEditor", fields: [editedById], references: [id])

  @@map("schedule_log_edits")
}

// ─── Notifications ──────────────────────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String
  title     String
  message   String
  month     String?
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── Forecasting & Targets ──────────────────────────────────────────────────

model AnnualTarget {
  id                  Int      @id @default(autoincrement())
  year                Int      @unique
  totalTargetMillions Decimal  @map("total_target_millions") @db.Decimal(14, 2)
  remoteMonth         Int?     @map("remote_month") // null = auto (latest month with actuals)
  createdById         Int?     @map("created_by_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("annual_targets")
}

model MonthlyForecast {
  id              Int      @id @default(autoincrement())
  year            Int
  month           Int // 1=Jan
  clientId        Int      @map("client_id")
  channelMasterId Int      @map("channel_master_id")
  agencyId        Int      @map("agency_id")
  amountMillions  Decimal  @map("amount_millions") @db.Decimal(14, 2)
  notes           String?
  submittedById   Int      @map("submitted_by_id")
  submittedAt     DateTime @default(now()) @map("submitted_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  channelMaster ChannelMaster @relation(fields: [channelMasterId], references: [id])

  @@unique([year, month, clientId, channelMasterId])
  @@index([year, month])
  @@map("monthly_forecasts")
}

// Overall Budget worksheet, one row per client per month (the month rolls on
// the 15th, mirroring MonthlyForecast). "Actual" is NOT stored here — it is
// derived live from that client's MonthlyForecast total. Only the group-head
// entered figures live here: bestAmount and billingLastMonth (both full LKR).
model MonthlyBudget {
  id               Int      @id @default(autoincrement())
  year             Int
  month            Int // 1=Jan
  clientId         Int      @map("client_id")
  agencyId         Int      @map("agency_id")
  bestAmount       Decimal? @map("best_amount") @db.Decimal(16, 2)
  billingLastMonth Decimal? @map("billing_last_month") @db.Decimal(16, 2)
  submittedById    Int      @map("submitted_by_id")
  submittedAt      DateTime @default(now()) @map("submitted_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([year, month, clientId])
  @@index([year, month])
  @@map("monthly_budgets")
}

model ClientRequest {
  id            Int       @id @default(autoincrement())
  requestedById Int       @map("requested_by_id")
  clientName    String    @map("client_name")
  agencyId      Int?      @map("agency_id")
  notes         String?
  status        String    @default("pending") // pending | approved | rejected
  reviewedById  Int?      @map("reviewed_by_id")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("client_requests")
}

model ChannelRequest {
  id            Int         @id @default(autoincrement())
  requestedById Int         @map("requested_by_id")
  channelName   String      @map("channel_name")
  category      ChannelType
  notes         String?
  status        String      @default("pending") // pending | approved | rejected
  reviewedById  Int?        @map("reviewed_by_id")
  reviewedAt    DateTime?   @map("reviewed_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("channel_requests")
}

// ─── Auth ───────────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─── Media Packages ───────────────────────────────────────────────────────────

model MediaPackage {
  id          Int                @id @default(autoincrement())
  name        String
  category    String
  emailIntro  String             @map("email_intro")
  isActive    Boolean            @default(true) @map("is_active")
  createdById Int                @map("created_by_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  creator     User               @relation("PackageCreator", fields: [createdById], references: [id])
  lineItems   PackageLineItem[]
  recipients  PackageRecipient[]

  @@map("media_packages")
}

model PackageLineItem {
  id        Int          @id @default(autoincrement())
  packageId Int          @map("package_id")
  label     String
  rate      Decimal      @db.Decimal(12, 2)
  sortOrder Int          @default(0) @map("sort_order")
  package   MediaPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_line_items")
}

model PackageRecipient {
  id          Int              @id @default(autoincrement())
  packageId   Int              @map("package_id")
  userId      Int              @map("user_id")
  tokenHash   String?          @unique @map("token_hash")
  expiresAt   DateTime?        @map("expires_at")
  sentAt      DateTime?        @map("sent_at")
  respondedAt DateTime?        @map("responded_at")
  interest    PackageInterest?
  budgetNote  String?          @map("budget_note")
  clientName  String?          @map("client_name")
  notes       String?
  followUp    ResponseFollowUp @default(PENDING) @map("follow_up")
  createdAt   DateTime         @default(now()) @map("created_at")
  package     MediaPackage     @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user        User             @relation("PackageRecipientUser", fields: [userId], references: [id])

  @@map("package_recipients")
}
